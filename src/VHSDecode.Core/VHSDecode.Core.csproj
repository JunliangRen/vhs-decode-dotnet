<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Formats\format-params.snapshot.json" />
    <EmbeddedResource Include="Decode\Resources\upstream-baseline.json" />
    <EmbeddedResource Include="Formats\custom\*.txt" />
    <EmbeddedResource Include="CommandLine\Help\*.txt" />
    <EmbeddedResource Include="Tbc\Resources\sinc_lut.npz" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="VHSDecode.Core.Licenses.THIRD-PARTY-NOTICES.md" />
    <EmbeddedResource Include="..\..\third_party\intel-ipp\LICENSE.txt" LogicalName="VHSDecode.Core.Licenses.intel-ipp.LICENSE.txt" />
    <EmbeddedResource Include="..\..\third_party\libsndfile\COPYING.LGPL" LogicalName="VHSDecode.Core.Licenses.libsndfile.COPYING.LGPL" />
    <EmbeddedResource Include="..\..\third_party\libsndfile\README.md" LogicalName="VHSDecode.Core.Licenses.libsndfile.README.md" />
    <EmbeddedResource Include="..\..\third_party\libsoxr\COPYING.LGPL" LogicalName="VHSDecode.Core.Licenses.libsoxr.COPYING.LGPL" />
    <EmbeddedResource Include="..\..\third_party\libsoxr\LICENCE" LogicalName="VHSDecode.Core.Licenses.libsoxr.LICENCE" />
    <EmbeddedResource Include="..\..\third_party\libsoxr\README.md" LogicalName="VHSDecode.Core.Licenses.libsoxr.README.md" />
    <EmbeddedResource Include="..\..\third_party\libsoxr\soxr-a66f3ee-source.zip" LogicalName="VHSDecode.Core.Licenses.libsoxr.soxr-a66f3ee-source.zip" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="NetMQ" Version="4.0.4.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.11" />
    <!-- Align NetMQ's transitive dependency with the pinned .NET 11 preview runtime. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0-preview.7.26381.103" />
  </ItemGroup>

  <ItemGroup>
    <None Include="runtimes\win-x64\native\sndfile.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="sndfile.dll" />
    <None Include="runtimes\win-x64\native\soxr.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="soxr.dll" />
    <None Include="..\..\artifacts\native\Release\win-x64\vhsdecode_ipp.dll" Condition="Exists('..\..\artifacts\native\Release\win-x64\vhsdecode_ipp.dll')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="vhsdecode_ipp.dll" TargetPath="vhsdecode_ipp.dll" />
  </ItemGroup>

</Project>
